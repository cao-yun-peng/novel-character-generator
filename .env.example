# Copy only the non-secret settings you need into your process environment.
# Never commit or paste a real API key into this file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_ATTEMPTS=3
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_INITIAL_BACKOFF_SECONDS=0.5
DEEPSEEK_MAX_BACKOFF_SECONDS=8

