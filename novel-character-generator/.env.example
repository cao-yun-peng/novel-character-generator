APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_SERVICE_NAME=novel-character-generator-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true
METRICS_PATH=/metrics
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ARTIFACT_STORE=local
ARTIFACT_LOCAL_ROOT=./data/artifacts
MAX_UPLOAD_BYTES=20000000
MAX_CHUNK_INPUT_TOKENS=5000
CHUNK_OVERLAP_TOKENS=300
RETRIEVAL_INDEX_VERSION=retrieval-v1
RETRIEVAL_PASSAGE_TARGET_TOKENS=1000
RETRIEVAL_PASSAGE_OVERLAP_TOKENS=100
RETRIEVAL_LEXICAL_PROVIDER=sqlite_fts5
RETRIEVAL_LEXICAL_PROFILE_VERSION=zh-char-bigram-visual-v1
RETRIEVAL_VECTOR_STORE=qdrant_local
QDRANT_LOCAL_PATH=./data/qdrant
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSION=
EMBEDDING_PROFILE_VERSION=
EMBEDDING_NORMALIZATION=l2
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3
RETRIEVAL_BM25_TOP_K=40
RETRIEVAL_VECTOR_TOP_K=40
RETRIEVAL_RRF_K=60
RETRIEVAL_MAIN_HIT_LIMIT=16
RETRIEVAL_NEIGHBOR_COUNT=1
VISUAL_ENRICHMENT_MAX_PROVIDER_CALLS=1
VISUAL_ENRICHMENT_CONTEXT_BUDGET_TOKENS=8000
VISUAL_ENRICHMENT_TIMEOUT_SECONDS=180
MAX_TASK_ATTEMPTS=3
WORKER_LEASE_SECONDS=240
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_WIRE_API=chat_completions
LLM_THINKING_ENABLED=false
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TOTAL_DEADLINE_SECONDS=120
LLM_MAX_ITEMS_PER_RESULT=256
LLM_MAX_RETRIES=1
# Development only. Stores full provider responses and exposes an admin-only UI tab.
LLM_RAW_RESPONSE_CAPTURE_ENABLED=false
ENTITY_RESOLUTION_CONTEXT_BUDGET_TOKENS=12000
ENTITY_CONVERGENCE_SHARD_MAX_RECORDS=16
ENTITY_CONVERGENCE_SHARD_MAX_MENTIONS=32
ENTITY_CONVERGENCE_SHARD_MAX_INPUT_TOKENS=12000
ENTITY_CONVERGENCE_SHARD_MAX_OUTPUT_TOKENS=4500
ENTITY_CONVERGENCE_REPAIR_MAX_ATTEMPTS=2
ENTITY_RESOLUTION_MAX_CALLS_PER_RUN=2000
IMAGE_PROVIDER=mock
IMAGE_WORKFLOW_PROFILE=mock-character-portrait
IMAGE_WORKFLOW_VERSION=1
IMAGE_CANDIDATE_COUNT_MAX=4
AGENT_RUNTIME_ENABLED=false
AGENT_MAX_TURNS_DEFAULT=3
AGENT_MAX_TOOL_CALLS_DEFAULT=12
AGENT_MAX_REFLECTION_ROUNDS=1
AGENT_MAX_COST_DEFAULT=1.0
AGENT_DEADLINE_SECONDS_DEFAULT=180
AGENT_TOOL_WRITE_POLICY=approval_required
AUTH_MODE=api_key
USER_API_KEY=
ADMIN_API_KEY=
