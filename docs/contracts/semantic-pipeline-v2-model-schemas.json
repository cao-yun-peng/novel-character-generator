{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-pipeline-v2-model-schemas-v1.5",
  "title": "Semantic Pipeline V2 model input and output contracts",
  "$defs": {
    "BoundaryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "boundary_type", "chapter_ordinal"],
      "properties": {
        "boundary_id": {"type": "string", "minLength": 1},
        "boundary_type": {"enum": ["chapter", "scene", "event", "phase"]},
        "chapter_ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "IdentityMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_id", "mention_kind", "mention_quote", "context_ref"],
      "properties": {
        "mention_id": {"type": "string", "minLength": 1},
        "mention_kind": {"enum": ["explicit_name", "descriptor", "pronoun", "unknown"]},
        "mention_quote": {"type": "string", "minLength": 1},
        "context_ref": {"type": "string", "minLength": 1}
      }
    },
    "StableCharacterSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "explicit_names", "evidence_span_ids"],
      "properties": {
        "character_id": {"type": "string", "minLength": 1},
        "explicit_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_span_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "IdentityEvidenceEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "left_node", "right_node", "edge_kind", "evidence_span_ids", "strength", "conflicts"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "left_node": {"type": "string", "minLength": 1},
        "right_node": {"type": "string", "minLength": 1},
        "edge_kind": {"enum": ["direct_identity", "explicit_alias", "coreference_candidate", "narrative_continuity", "explicit_name_conflict", "exclusive_identity"]},
        "evidence_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "strength": {"enum": ["hard", "candidate"]},
        "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "CurrentIdentityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "mention_id", "character_id", "decision_artifact_id"],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "mention_id": {"type": "string", "minLength": 1},
        "character_id": {"type": "string", "minLength": 1},
        "decision_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "TemporalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "fact_id", "field_path", "normalized_value", "epistemic_status", "chapter_ordinal", "evidence_span_ids"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "fact_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["asserted", "negated"]},
        "chapter_ordinal": {"type": "integer", "minimum": 0},
        "evidence_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "TemporalSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "signal_kind", "raw_label", "evidence_span_ids", "fact_ids"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "signal_kind": {"enum": ["age", "life_phase", "time_jump", "presentation", "transformation", "other_state"]},
        "raw_label": {"type": "string", "minLength": 1},
        "evidence_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "fact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "ExistingPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "phase_key", "evidence_span_ids"],
      "properties": {
        "phase_id": {"type": "string", "minLength": 1},
        "phase_key": {"type": "string", "minLength": 1},
        "evidence_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "NarrativeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "window_text", "boundary_ids"],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "window_text": {"type": "string", "minLength": 1},
        "boundary_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "ReviewCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "fact_id", "evidence_quote", "field_path", "normalized_value", "epistemic_status", "identity_decision_id", "temporal_decision_id", "semantic_unit_id", "conflict_ids"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "fact_id": {"type": "string", "minLength": 1},
        "evidence_quote": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["asserted", "negated"]},
        "identity_decision_id": {"type": "string", "minLength": 1},
        "temporal_decision_id": {"type": "string", "minLength": 1},
        "semantic_unit_id": {"type": "string", "minLength": 1},
        "conflict_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "VisualEvidenceDiscoveryInput": {
      "description": "Target M1 v2 input. The model receives only the frozen chunk text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_text"],
      "properties": {
        "chunk_text": {"type": "string", "minLength": 1}
      }
    },
    "VisualEvidenceDiscoveryOutput": {
      "description": "Target M1 v2 output. It discovers verbatim evidence only and performs no semantic classification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mentions", "evidence_candidates"],
      "properties": {
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mention_quote"],
            "properties": {
              "mention_quote": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner_index", "evidence_quote"],
            "properties": {
              "owner_index": {"type": ["integer", "null"], "minimum": 0},
              "evidence_quote": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "EvidenceGroundingInput": {
      "description": "Deterministic N2 v2 input over the frozen chunk and M1 v2 discovery output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "source_document_version_id", "chunk_id", "chunk_text", "discovery", "max_context_chars"],
      "properties": {
        "schema_version": {"const": "evidence-grounding-input-v2"},
        "run_id": {"type": "string", "minLength": 1},
        "source_document_version_id": {"type": "string", "minLength": 1},
        "chunk_id": {"type": "string", "minLength": 1},
        "chunk_text": {"type": "string", "minLength": 1},
        "discovery": {"$ref": "#/$defs/VisualEvidenceDiscoveryOutput"},
        "max_context_chars": {"type": "integer", "minimum": 64, "maximum": 4000}
      }
    },
    "GroundedEvidencePacket": {
      "description": "Deterministic N2 v2 packet. It grounds source spans and routes structural failures without visual-semantic interpretation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "source_document_version_id", "chunk_id", "grounding_policy_version", "context_policy_version", "mention_nodes", "grounded_candidates", "rejected_items", "deferred_items"],
      "properties": {
        "schema_version": {"const": "grounded-evidence-packet-v2"},
        "run_id": {"type": "string", "minLength": 1},
        "source_document_version_id": {"type": "string", "minLength": 1},
        "chunk_id": {"type": "string", "minLength": 1},
        "grounding_policy_version": {"const": "evidence-grounding-policy-v2"},
        "context_policy_version": {"const": "evidence-context-sentence-window-v2"},
        "mention_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["local_owner_id", "mention_quote", "grounding_status", "occurrence_count", "evidence_span"],
            "properties": {
              "local_owner_id": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
              "mention_quote": {"type": "string", "minLength": 1},
              "grounding_status": {"enum": ["exact", "whitespace_unique", "ambiguous", "not_found"]},
              "occurrence_count": {"type": "integer", "minimum": 0},
              "evidence_span": {"anyOf": [{"$ref": "#/$defs/EvidenceSpanV2"}, {"type": "null"}]}
            }
          }
        },
        "grounded_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "source_candidate_id", "local_owner_id", "evidence_quote", "evidence_span", "grounding_status", "local_context"],
            "properties": {
              "candidate_id": {"type": "string", "pattern": "^ge_[0-9a-f]{32}$"},
              "source_candidate_id": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
              "local_owner_id": {"type": ["string", "null"], "pattern": "^m[1-9][0-9]*$"},
              "evidence_quote": {"type": "string", "minLength": 1},
              "evidence_span": {"$ref": "#/$defs/EvidenceSpanV2"},
              "grounding_status": {"enum": ["exact", "whitespace_unique"]},
              "local_context": {"$ref": "#/$defs/EvidenceContextWindowV2"}
            }
          }
        },
        "rejected_items": {"type": "array", "items": {"$ref": "#/$defs/EvidenceGroundingIssueV2"}},
        "deferred_items": {"type": "array", "items": {"$ref": "#/$defs/EvidenceGroundingIssueV2"}}
      }
    },
    "EvidenceSpanV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "source_quote", "quote_hash"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "source_quote": {"type": "string", "minLength": 1},
        "quote_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "EvidenceContextWindowV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "start", "end", "text", "focus_start", "focus_end", "context_hash"],
      "properties": {
        "policy_version": {"const": "evidence-context-sentence-window-v2"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "focus_start": {"type": "integer", "minimum": 0},
        "focus_end": {"type": "integer", "minimum": 1},
        "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "EvidenceGroundingIssueV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_candidate_id", "local_owner_id", "evidence_quote", "reason_code", "occurrence_count"],
      "properties": {
        "source_candidate_id": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
        "local_owner_id": {"type": ["string", "null"], "pattern": "^m[1-9][0-9]*$"},
        "evidence_quote": {"type": "string", "minLength": 1},
        "reason_code": {"enum": ["quote_not_in_chunk", "ambiguous_evidence", "local_context_budget_exceeded", "deterministic_duplicate"]},
        "occurrence_count": {"type": "integer", "minimum": 0}
      }
    },
    "LocalVisualSemanticParsingInput": {
      "description": "Target M2 v2 input over N2-grounded evidence candidates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "canonical_field_catalog"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_quote", "owner_mention_quote", "local_context"],
            "properties": {
              "evidence_quote": {"type": "string", "minLength": 1},
              "owner_mention_quote": {"type": ["string", "null"], "minLength": 1},
              "local_context": {"type": "string", "minLength": 1}
            }
          }
        },
        "canonical_field_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "value_type", "description"],
            "properties": {
              "field_path": {"type": "string", "minLength": 1},
              "value_type": {"const": "string"},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "LocalVisualSemanticParsingResult": {
      "description": "Target M2 v2 result with semantic units, epistemic status and explicit local signals.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_index", "decision", "semantic_units", "temporal_signals", "reason_code"],
            "properties": {
              "candidate_index": {"type": "integer", "minimum": 0},
              "decision": {"enum": ["map", "signal_only", "defer", "reject"]},
              "semantic_units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["semantic_unit_index", "referent_kind", "referent_quote", "field_path", "normalized_value", "epistemic_status"],
                  "properties": {
                    "semantic_unit_index": {"type": "integer", "minimum": 0},
                    "referent_kind": {"enum": ["whole_character", "body_part", "garment", "accessory", "appearance_state", "other_visual"]},
                    "referent_quote": {"type": ["string", "null"], "minLength": 1},
                    "field_path": {"type": "string", "minLength": 1},
                    "normalized_value": {"type": "string", "minLength": 1},
                    "epistemic_status": {"enum": ["asserted", "negated", "uncertain", "inferred"]}
                  }
                }
              },
              "temporal_signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["signal_quote", "signal_kind", "semantic_unit_indices"],
                  "properties": {
                    "signal_quote": {"type": "string", "minLength": 1},
                    "signal_kind": {"enum": ["age", "life_phase", "time_jump", "presentation", "transformation", "other_state"]},
                    "semantic_unit_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
                  }
                }
              },
              "reason_code": {"enum": ["explicit_semantic_mapping", "explicit_signal_only", "ambiguous_semantic_decomposition", "missing_semantic_context", "unsupported_visual_candidate", "held_or_nearby_object", "non_visual_content"]}
            },
            "allOf": [
              {
                "if": {"properties": {"decision": {"const": "map"}}},
                "then": {"properties": {"semantic_units": {"minItems": 1}, "reason_code": {"const": "explicit_semantic_mapping"}}}
              },
              {
                "if": {"properties": {"decision": {"const": "signal_only"}}},
                "then": {"properties": {"semantic_units": {"maxItems": 0}, "temporal_signals": {"minItems": 1}, "reason_code": {"const": "explicit_signal_only"}}}
              },
              {
                "if": {"properties": {"decision": {"enum": ["defer", "reject"]}}},
                "then": {"properties": {"semantic_units": {"maxItems": 0}, "temporal_signals": {"maxItems": 0}}}
              }
            ]
          }
        }
      }
    },
    "LocalObservationModelInput": {
      "description": "Legacy implemented M1 v1 input retained for historical compatibility.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_text"],
      "properties": {
        "chunk_text": {"type": "string", "minLength": 1}
      }
    },
    "LocalObservationModelOutput": {
      "description": "Legacy implemented M1 v1 output; not the target v2 boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "facts", "temporal_signals", "unresolved_items"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mention_quote", "mention_kind"],
            "properties": {
              "mention_quote": {"type": "string", "minLength": 1},
              "mention_kind": {"enum": ["explicit_name", "descriptor", "pronoun", "unknown"]}
            }
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner_index", "evidence_quote", "raw_proposition", "coarse_family", "epistemic_status"],
            "properties": {
              "owner_index": {"type": "integer", "minimum": 0},
              "evidence_quote": {"type": "string", "minLength": 1},
              "raw_proposition": {"type": "string", "minLength": 1},
              "coarse_family": {"enum": ["physical_identity", "hair", "face", "body", "clothing", "worn_accessory", "cleanliness", "injury", "distinctive_mark", "disguise", "other_visual"]},
              "epistemic_status": {"enum": ["asserted", "negated", "uncertain", "inferred"]}
            }
          }
        },
        "temporal_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_quote", "signal_kind"],
            "properties": {
              "owner_index": {"type": ["integer", "null"], "minimum": 0},
              "fact_index": {"type": ["integer", "null"], "minimum": 0},
              "evidence_quote": {"type": "string", "minLength": 1},
              "signal_kind": {"enum": ["age", "life_phase", "time_jump", "presentation", "transformation", "other_state"]}
            }
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_quote", "raw_proposition", "reason_code"],
            "properties": {
              "owner_index": {"type": ["integer", "null"], "minimum": 0},
              "evidence_quote": {"type": "string", "minLength": 1},
              "raw_proposition": {"type": "string", "minLength": 1},
              "reason_code": {"enum": ["ambiguous_owner", "ambiguous_evidence", "ambiguous_local_scope", "unsupported_visual_content"]}
            }
          }
        }
      }
    },
    "FieldDisambiguationInput": {
      "description": "Legacy implemented M2 v1 input retained for historical compatibility.",
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "canonical_field_catalog"],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_quote", "raw_proposition", "coarse_family", "epistemic_status", "local_context"],
            "properties": {
              "evidence_quote": {"type": "string", "minLength": 1},
              "raw_proposition": {"type": "string", "minLength": 1},
              "coarse_family": {"type": "string", "minLength": 1},
              "epistemic_status": {"enum": ["asserted", "negated", "uncertain", "inferred"]},
              "local_context": {"type": "string"}
            }
          }
        },
        "canonical_field_catalog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "value_type", "description"],
            "properties": {
              "field_path": {"type": "string", "minLength": 1},
              "value_type": {"const": "string"},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "FieldDisambiguationResult": {
      "description": "Legacy implemented M2 v1 result; not the target v2 boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_index", "decision", "mappings", "reason_code"],
            "properties": {
              "fact_index": {"type": "integer", "minimum": 0},
              "decision": {"enum": ["map", "defer", "reject"]},
              "mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["semantic_unit_index", "referent_kind", "referent_quote", "field_path", "normalized_value"],
                  "properties": {
                    "semantic_unit_index": {"type": "integer", "minimum": 0},
                    "referent_kind": {"enum": ["whole_character", "body_part", "garment", "accessory", "appearance_state", "other_visual"]},
                    "referent_quote": {"type": ["string", "null"], "minLength": 1},
                    "field_path": {"type": "string", "minLength": 1},
                    "normalized_value": {"type": "string", "minLength": 1}
                  }
                }
              },
              "reason_code": {"enum": ["explicit_atomic_mapping", "ambiguous_semantic_decomposition", "missing_semantic_context", "unsupported_visual_fact", "held_or_nearby_object", "non_visual_content"]}
            },
            "allOf": [
              {
                "if": {"properties": {"decision": {"const": "map"}}},
                "then": {"properties": {"mappings": {"minItems": 1}, "reason_code": {"const": "explicit_atomic_mapping"}}},
                "else": {"properties": {"mappings": {"maxItems": 0}}}
              }
            ]
          }
        }
      }
    },
    "IdentityComponentResolutionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component_id", "mentions", "stable_characters", "evidence_edges", "conflict_edges", "current_bindings", "component_completeness"],
      "properties": {
        "schema_version": {"const": "identity-component-resolution-input-v1.1"},
        "component_id": {"type": "string", "minLength": 1},
        "mentions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/IdentityMention"}},
        "stable_characters": {"type": "array", "items": {"$ref": "#/$defs/StableCharacterSummary"}},
        "evidence_edges": {"type": "array", "items": {"$ref": "#/$defs/IdentityEvidenceEdge"}},
        "conflict_edges": {"type": "array", "items": {"$ref": "#/$defs/IdentityEvidenceEdge"}},
        "current_bindings": {"type": "array", "items": {"$ref": "#/$defs/CurrentIdentityBinding"}},
        "component_completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_generator_version", "truncated", "reason_codes"],
          "properties": {
            "status": {"enum": ["complete", "partial", "blocked"]},
            "candidate_generator_version": {"type": "string", "minLength": 1},
            "truncated": {"type": "boolean"},
            "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      }
    },
    "IdentityComponentResolutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component_id", "decisions"],
      "properties": {
        "schema_version": {"const": "identity-component-resolution-v1.1"},
        "component_id": {"type": "string", "minLength": 1},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mention_id", "action", "target_character_id", "creation_group_key", "evidence_edge_ids", "supersedes_binding_ids", "decision_basis"],
            "properties": {
              "mention_id": {"type": "string", "minLength": 1},
              "action": {"enum": ["link_existing", "create_group", "keep_unresolved"]},
              "target_character_id": {"type": ["string", "null"]},
              "creation_group_key": {"type": ["string", "null"]},
              "evidence_edge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "supersedes_binding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "decision_basis": {"enum": ["direct_identity", "explicit_alias", "unambiguous_coreference", "strong_narrative_continuity", "insufficient_evidence"]}
            },
            "allOf": [
              {
                "if": {"properties": {"action": {"const": "link_existing"}}},
                "then": {"properties": {"target_character_id": {"type": "string", "minLength": 1}, "creation_group_key": {"type": "null"}, "evidence_edge_ids": {"minItems": 1}}}
              },
              {
                "if": {"properties": {"action": {"const": "create_group"}}},
                "then": {"properties": {"target_character_id": {"type": "null"}, "creation_group_key": {"type": "string", "minLength": 1}, "evidence_edge_ids": {"minItems": 1}}}
              },
              {
                "if": {"properties": {"action": {"const": "keep_unresolved"}}},
                "then": {"properties": {"target_character_id": {"type": "null"}, "creation_group_key": {"type": "null"}, "decision_basis": {"const": "insufficient_evidence"}}}
              }
            ]
          }
        }
      }
    },
    "TemporalAmbiguityResolutionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component_id", "character_id", "observations", "signals", "existing_phases", "narrative_windows", "boundary_catalog"],
      "properties": {
        "schema_version": {"const": "temporal-ambiguity-resolution-input-v1.1"},
        "component_id": {"type": "string", "minLength": 1},
        "character_id": {"type": "string", "minLength": 1},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TemporalObservation"}},
        "signals": {"type": "array", "items": {"$ref": "#/$defs/TemporalSignal"}},
        "existing_phases": {"type": "array", "items": {"$ref": "#/$defs/ExistingPhase"}},
        "narrative_windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/NarrativeWindow"}},
        "boundary_catalog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/BoundaryRef"}}
      }
    },
    "TemporalAmbiguityResolutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "component_id", "decisions"],
      "properties": {
        "schema_version": {"const": "temporal-ambiguity-resolution-v1.1"},
        "component_id": {"type": "string", "minLength": 1},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observation_id", "action", "phase_id", "phase_key_hint", "presentation_mode", "reality_status", "transformation_state", "scope_type", "persistence_class", "start_boundary", "end_boundary", "end_condition", "evidence_signal_ids", "evidence_window_ids", "reason_code"],
            "properties": {
              "observation_id": {"type": "string", "minLength": 1},
              "action": {"enum": ["bind_scope", "keep_unknown", "needs_review"]},
              "phase_id": {"type": ["string", "null"]},
              "phase_key_hint": {"type": ["string", "null"]},
              "presentation_mode": {"enum": ["direct", "flashback", "flashforward", "dream", "illusion", "rumor", "hypothetical", "unknown"]},
              "reality_status": {"enum": ["canonical", "subjective", "alleged", "counterfactual", "unknown"]},
              "transformation_state": {"type": ["string", "null"]},
              "scope_type": {"enum": ["phase", "chapter", "scene", "event", "persistent_change", "unknown"]},
              "persistence_class": {"enum": ["identity_anchor", "phase_base", "persistent_change", "outfit_state", "transformation_state", "scene_temporary", null]},
              "start_boundary": {"anyOf": [{"$ref": "#/$defs/BoundaryRef"}, {"type": "null"}]},
              "end_boundary": {"anyOf": [{"$ref": "#/$defs/BoundaryRef"}, {"type": "null"}]},
              "end_condition": {"enum": ["explicit_boundary", "scene_end", "chapter_end", "phase_end", "next_state_change", "open_ended", "unknown", null]},
              "evidence_signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "evidence_window_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "reason_code": {"enum": ["unique_explicit_scope", "insufficient_scope_evidence", "conflicting_scope_evidence", "canonical_anchor_impact", "unsupported_temporal_structure"]}
            },
            "allOf": [
              {
                "not": {
                  "properties": {
                    "phase_id": {"type": "string"},
                    "phase_key_hint": {"type": "string"}
                  },
                  "required": ["phase_id", "phase_key_hint"]
                }
              },
              {
                "if": {"properties": {"action": {"const": "bind_scope"}}},
                "then": {
                  "properties": {
                    "scope_type": {"enum": ["phase", "chapter", "scene", "event", "persistent_change"]},
                    "persistence_class": {"enum": ["identity_anchor", "phase_base", "persistent_change", "outfit_state", "transformation_state", "scene_temporary"]},
                    "start_boundary": {"$ref": "#/$defs/BoundaryRef"},
                    "end_condition": {"enum": ["explicit_boundary", "scene_end", "chapter_end", "phase_end", "next_state_change", "open_ended"]},
                    "evidence_window_ids": {"minItems": 1}
                  }
                },
                "else": {"properties": {"phase_id": {"type": "null"}, "phase_key_hint": {"type": "null"}, "transformation_state": {"type": "null"}, "scope_type": {"const": "unknown"}, "persistence_class": {"type": "null"}, "start_boundary": {"type": "null"}, "end_boundary": {"type": "null"}, "end_condition": {"type": "null"}}}
              },
              {
                "if": {"properties": {"scope_type": {"const": "phase"}}},
                "then": {
                  "oneOf": [
                    {"properties": {"phase_id": {"type": "string", "minLength": 1}, "phase_key_hint": {"type": "null"}}},
                    {"properties": {"phase_id": {"type": "null"}, "phase_key_hint": {"type": "string", "minLength": 1}}}
                  ]
                }
              },
              {
                "if": {"properties": {"end_condition": {"const": "explicit_boundary"}}},
                "then": {"properties": {"end_boundary": {"$ref": "#/$defs/BoundaryRef"}}}
              }
            ]
          }
        }
      }
    },
    "SemanticPromotionReviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_group_id", "character_id", "scope_key", "group_completeness", "candidates", "peer_conflicts", "promotion_policy_version"],
      "properties": {
        "schema_version": {"const": "semantic-promotion-review-input-v1.1"},
        "review_group_id": {"type": "string", "minLength": 1},
        "character_id": {"type": "string", "minLength": 1},
        "scope_key": {"type": "string", "minLength": 1},
        "group_completeness": {"enum": ["complete", "partial", "blocked"]},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ReviewCandidate"}},
        "peer_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conflict_id", "candidate_ids", "conflict_kind"],
            "properties": {
              "conflict_id": {"type": "string", "minLength": 1},
              "candidate_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "conflict_kind": {"enum": ["exclusive_field_value", "overlapping_scope", "semantic_unit_mismatch", "protected_fact_conflict", "other"]}
            }
          }
        },
        "promotion_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "SemanticPromotionReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_group_id", "reviews"],
      "properties": {
        "schema_version": {"const": "semantic-promotion-review-v1.1"},
        "review_group_id": {"type": "string", "minLength": 1},
        "reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "decision", "evidence_ids", "issue_codes"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "decision": {"enum": ["approve_candidate", "needs_review", "reject"]},
              "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "issue_codes": {
                "type": "array",
                "items": {"enum": ["unsupported_field_value", "non_visual_fact", "owner_evidence_insufficient", "owner_conflict", "scope_evidence_insufficient", "phase_conflict", "transformation_leakage", "persistence_unsupported", "canonical_anchor_risk", "cross_node_inconsistency", "peer_candidate_conflict", "incomplete_review_group"]},
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {"properties": {"decision": {"const": "approve_candidate"}}},
                "then": {"properties": {"evidence_ids": {"minItems": 1}, "issue_codes": {"maxItems": 0}}},
                "else": {"properties": {"issue_codes": {"minItems": 1}}}
              }
            ]
          }
        }
      }
    }
  }
}
